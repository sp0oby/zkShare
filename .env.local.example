# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Auth + Postgres)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App secrets (server-only — never NEXT_PUBLIC_)
# Min 32 random bytes / chars for AES-256 + proof HMACs
ZKSHARE_ENCRYPTION_SECRET=change-me-to-a-long-random-string-at-least-32
ZKSHARE_PROOF_SECRET=another-long-random-secret-16chars-min

# Enclave simulation signing (HS256 JWT for proof_of_execution)
ZKSHARE_ENCLAVE_JWT_SECRET=dev-only-change-me-32chars-minimum!!
ZKSHARE_ENCLAVE_PUBLIC_KEY_STUB=optional-stub-for-attestation-display

# LLM / embeddings (optional — see SECURITY.md)
# Prefer OpenRouter for a single gateway; free chat default: google/gemma-2-9b-it:free
OPENROUTER_API_KEY=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
# Optional OpenRouter headers (some tiers / rankings)
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=ZKshare
OPENROUTER_CHAT_MODEL=google/gemma-2-9b-it:free
# Free embedding example — confirm slug on openrouter.ai/models (embedding)
OPENROUTER_EMBEDDING_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2:free
# Set to false only if you need provider fallbacks that may retain data
# ZKSHARE_OPENROUTER_DENY_DATA_COLLECTION=false

# OpenAI (used only if OPENROUTER_API_KEY is unset)
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# No external LLM calls (heuristics only for prove/share/search NL) — strongest “no third party” mode
# ZKSHARE_DISABLE_EXTERNAL_LLM=true

# Upstash Redis (edge-friendly rate limits; optional — uses in-memory fallback locally)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# CORS for /api/v1/context (production: https://yourapp.com — not "*")
ZKSHARE_CORS_ORIGIN=*

# Stripe — subscription prices + metered overage item (optional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=
STRIPE_METERED_PRICE_ID=
