# Copy to .env.local and fill in values. Never commit .env.local.
# All secrets below should be empty here — generate locally (see comments).

# Site
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Auth + Postgres) — from Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# App secrets (server-only — never NEXT_PUBLIC_)
# ZKSHARE_ENCRYPTION_SECRET: min ~32 chars (AES-256). ZKSHARE_PROOF_SECRET: min 16 chars.
ZKSHARE_ENCRYPTION_SECRET=
ZKSHARE_PROOF_SECRET=

# Enclave simulation signing (HS256 JWT for proof_of_execution)
ZKSHARE_ENCLAVE_JWT_SECRET=
# Optional display stub only
ZKSHARE_ENCLAVE_PUBLIC_KEY_STUB=

# LLM / embeddings (optional — see SECURITY.md)
OPENROUTER_API_KEY=
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=ZKshare
OPENROUTER_CHAT_MODEL=
OPENROUTER_EMBEDDING_MODEL=
# ZKSHARE_OPENROUTER_DENY_DATA_COLLECTION=false

# OpenAI (used only if OPENROUTER_API_KEY is unset)
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=
OPENAI_EMBEDDING_MODEL=

# ZKSHARE_DISABLE_EXTERNAL_LLM=true

# Upstash Redis (rate limits; optional locally)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# CORS for /api/v1/context — production: your site origin, not "*"
ZKSHARE_CORS_ORIGIN=

# Stripe (optional)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=
STRIPE_METERED_PRICE_ID=
